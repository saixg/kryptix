# ==============================================================================
# ROGUE — LLM Platform Environment Configuration
# ==============================================================================
# Copy this file to `.env` and insert your actual API key(s).
# Never commit your `.env` file to Git or version control!

# ------------------------------------------------------------------------------
# 1. API Keys (Provide at least one)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Get key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Provider & Model Configuration
# ------------------------------------------------------------------------------
# Preferred provider: 'gemini' (default) or 'openai'
DEFAULT_PROVIDER=gemini

# Recommended Gemini model: gemini-3.5-flash-lite (fast, high throughput) or gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Recommended OpenAI model: gpt-4o-mini or gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Context Window Management
# ------------------------------------------------------------------------------
# Strategy options:
#  - 'summarize': Summarizes older messages into a rolling synopsis + keeps the most recent turns
#  - 'sliding_window': Keeps only the last N messages, dropping earlier turns
CONTEXT_STRATEGY=summarize

# Maximum number of recent messages to keep in active context before truncation / summarization
# (e.g. 6 messages = 3 user/assistant turns)
MAX_ACTIVE_MESSAGES=6

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
